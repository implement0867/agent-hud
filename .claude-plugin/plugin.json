{
  "name": "agent-hud",
  "version": "0.1.2",
  "description": "A board in the browser that the agent and the user share: cards, feedback, input cells and arrows",
  "author": {
    "name": "implement0867"
  },
  "repository": "https://github.com/implement0867/agent-hud",
  "mcpServers": {
    "board": {
      "type": "http",
      "url": "http://127.0.0.1:${AGENT_HUD_PORT:-7676}/mcp/",
      "headers": {
        "Authorization": "Bearer ${AGENT_HUD_TOKEN:-}",
        "X-Agent-Hud-Board": "${CLAUDE_PROJECT_DIR}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/serve.sh"
          }
        ]
      }
    ]
  }
}
